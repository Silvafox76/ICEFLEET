# ICE FLEET - Docker Environment Configuration Example
# Copy this file to .env and configure your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/icefleet

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME=ICE FLEET

# ============================================
# NEXTAUTH CONFIGURATION (Optional - for future use)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ============================================
# ICEHUB INTEGRATION (Configure when integrating)
# ============================================
ICE_CRM_API_URL=http://ice-crm:3001/api
ICE_CRM_API_KEY=your_ice_crm_api_key
ICE_CERT_API_URL=http://ice-cert:3002/api
ICE_CERT_API_KEY=your_ice_cert_api_key

# ============================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================
MAPBOX_API_KEY=your_mapbox_api_key
SENTRY_DSN=your_sentry_dsn

# ============================================
# GOOGLE OAUTH (Uncomment to enable - for future use)
# ============================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
