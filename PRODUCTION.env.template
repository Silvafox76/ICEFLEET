# ============================================
# ICE FLEET - PRODUCTION ENVIRONMENT VARIABLES
# Render Deployment Configuration
# ============================================
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real values to git
# 2. This template shows what needs to be configured in Render Dashboard
# 3. All secrets should be set in Render's Environment tab
# 4. Use render.yaml for automated configuration
#
# Last Updated: 2025-10-18
# ============================================

# ============================================
# CRITICAL - REQUIRED FOR DEPLOYMENT
# ============================================

# Database Connection (Render Auto-Generates This)
# Set in Render Dashboard → Environment → Add from Database
DATABASE_URL=<Will be auto-set by Render when you link the database>
# Example format: postgresql://user:password@host:5432/database

# NextAuth Secret (Generate with: openssl rand -base64 32)
# CRITICAL: Must be at least 32 characters, random, and kept secret
NEXTAUTH_SECRET=<Generate with: openssl rand -base64 32>
# Example: dGhpc19pc19hX3NlY3VyZV9yYW5kb21fc2VjcmV0X2tleQ==

# NextAuth URL (Render Auto-Sets This)
# Format: https://your-service-name.onrender.com
NEXTAUTH_URL=<Will be auto-set by Render to your service URL>
# Example: https://icefleet-app.onrender.com

# Node Environment (ALWAYS set to production for Render)
NODE_ENV=production

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application Name (Public, safe to expose)
NEXT_PUBLIC_APP_NAME=ICE FLEET

# Port (Render auto-sets this, usually 3000)
# Do NOT set this manually - Render will configure it
# PORT=<Auto-set by Render>

# ============================================
# OPTIONAL - ICEHUB INTEGRATION
# Only set these if you're integrating with ICEHUB
# ============================================

# ICE CRM API Configuration
# ICE_CRM_API_URL=https://crm.icehub.ca/api
# ICE_CRM_API_KEY=<Your secure API key for CRM integration>

# ICE Certification API Configuration
# ICE_CERT_API_URL=https://cert.icehub.ca/api
# ICE_CERT_API_KEY=<Your secure API key for Cert integration>

# ============================================
# OPTIONAL - THIRD-PARTY SERVICES
# Only set these if you're using these services
# ============================================

# Mapbox API (for map visualizations)
# Get your key from: https://account.mapbox.com/access-tokens/
# MAPBOX_API_KEY=<Your Mapbox public API key>

# Sentry (Error Tracking - Recommended for production)
# Get your DSN from: https://sentry.io/settings/projects/
# SENTRY_DSN=<Your Sentry DSN for error tracking>

# ============================================
# OPTIONAL - GOOGLE OAUTH (Future Feature)
# Only set these if you're enabling Google OAuth
# ============================================

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=<Your Google OAuth Client ID>

# Google OAuth Client Secret
# GOOGLE_CLIENT_SECRET=<Your Google OAuth Client Secret>

# ============================================
# BUILD-TIME CONFIGURATION (Docker Only)
# ============================================

# Skip environment validation during Docker build
# This is set automatically in the Dockerfile
# SKIP_ENV_VALIDATION=true

# Next.js Telemetry (Disabled in Dockerfile)
# NEXT_TELEMETRY_DISABLED=1

# ============================================
# RENDER-SPECIFIC NOTES
# ============================================
#
# How to Set Environment Variables in Render:
#
# 1. Go to https://dashboard.render.com
# 2. Select your web service (icefleet-app)
# 3. Click "Environment" in the left sidebar
# 4. Click "Add Environment Variable"
# 5. Enter each key-value pair from above
#
# For DATABASE_URL:
# - Click "Add from Database"
# - Select your icefleet-db database
# - This will auto-populate with the connection string
#
# For NEXTAUTH_SECRET:
# - Click "Generate Value" or paste your own generated value
# - Use: openssl rand -base64 32
#
# For NEXTAUTH_URL:
# - Set to: https://your-service-name.onrender.com
# - Or let Render auto-detect from RENDER_EXTERNAL_URL
#
# ============================================
# SECURITY CHECKLIST
# ============================================
#
# Before deployment, verify:
# ✅ DATABASE_URL is set (auto from database)
# ✅ NEXTAUTH_SECRET is generated (32+ bytes, random)
# ✅ NEXTAUTH_URL matches your Render service URL
# ✅ NODE_ENV=production
# ✅ No secrets hardcoded in application code
# ✅ .env files are in .gitignore
# ✅ All optional keys are commented out if not used
#
# ============================================
# GENERATING SECURE SECRETS
# ============================================
#
# Generate NEXTAUTH_SECRET:
#
# Option 1 - Linux/Mac:
#   openssl rand -base64 32
#
# Option 2 - Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Option 3 - Python:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Option 4 - PowerShell (Windows):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Option 5 - Render Dashboard:
#   Click "Generate Value" when adding NEXTAUTH_SECRET
#
# ============================================
# TROUBLESHOOTING
# ============================================
#
# If deployment fails:
#
# 1. Check Render logs for specific error
# 2. Verify DATABASE_URL is correctly set
# 3. Ensure NEXTAUTH_SECRET is at least 32 characters
# 4. Confirm all required variables are set
# 5. Check health endpoint: https://your-app.onrender.com/api/health
#
# Common Issues:
#
# - "DATABASE_URL is required": Set in Render → Add from Database
# - "Prisma migration failed": Check database connectivity
# - "500 Internal Server Error": Check Render logs
# - "Health check failed": Verify database is running
#
# ============================================
# DEPLOYMENT VERIFICATION
# ============================================
#
# After deployment, test these endpoints:
#
# 1. Health Check:
#    curl https://your-app.onrender.com/api/health
#    Should return: {"status":"healthy","database":"connected"}
#
# 2. Dashboard Stats:
#    curl https://your-app.onrender.com/api/dashboard/stats
#    Should return: JSON with fleet statistics
#
# 3. Vehicles:
#    curl https://your-app.onrender.com/api/fleet/vehicles
#    Should return: Array of vehicles (may be empty)
#
# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
#
# Render automatically backs up PostgreSQL databases on Starter+ plans.
#
# Manual Backup (if needed):
#   render db backup create --service-name icefleet-db
#
# Restore from Backup:
#   Contact Render support or use pg_restore
#
# ============================================
# MONITORING & MAINTENANCE
# ============================================
#
# Regular Tasks:
# - Weekly: Review Render logs for errors
# - Monthly: Run `npm audit` and update dependencies
# - Quarterly: Rotate NEXTAUTH_SECRET
# - As Needed: Update DATABASE_URL if database is migrated
